{
  "name": "sagyou-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sagyou — Kanban pessoal offline",
  "author": "gomesluis.dev@gmail.com",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sync-server"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "dev": "npm run dev -w sagyou",
    "start": "npm run start -w sagyou",
    "build": "npm run build -w sagyou",
    "build:unpack": "npm run build:unpack -w sagyou",
    "build:win": "npm run build:win -w sagyou",
    "build:mac": "npm run build:mac -w sagyou",
    "build:linux": "npm run build:linux -w sagyou",
    "prepare:markitdown": "npm run prepare:markitdown -w sagyou",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w sagyou",
    "test:coverage": "npm run test:coverage -w sagyou",
    "postinstall": "npm run rebuild:native -w sagyou"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
