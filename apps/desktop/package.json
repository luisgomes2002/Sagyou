{
  "name": "sagyou",
  "version": "1.13.0",
  "private": true,
  "description": "Sagyou — Kanban pessoal offline",
  "main": "./out/main/index.js",
  "author": "gomesluis.dev@gmail.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run prepare:markitdown && electron-vite dev -- --no-sandbox",
    "build": "npm run typecheck && electron-vite build",
    "prepare:markitdown": "node scripts/build-markitdown-runtime.mjs",
    "rebuild:native": "electron-rebuild --force --only better-sqlite3 --module-dir .",
    "build:unpack": "npm run prepare:markitdown && npm run build && electron-builder --dir",
    "build:win": "npm run prepare:markitdown && npm run build && electron-builder --win --publish never",
    "build:mac": "npm run prepare:markitdown && electron-vite build && electron-builder --mac --publish never",
    "build:linux": "npm run prepare:markitdown && electron-vite build && electron-builder --linux --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.2",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.60.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sagyou/core": "*",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "ico": "^0.3.3",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.8"
  }
}
